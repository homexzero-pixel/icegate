# Copy to .env and fill in. .env is git-ignored. Never commit a real key.
ICEGATE_API_BASE=
ICEGATE_API_KEY=
# How the key is sent. Default: "Authorization: Bearer <key>".
ICEGATE_API_KEY_HEADER=Authorization
ICEGATE_API_KEY_PREFIX=Bearer
# Path appended to ICEGATE_API_BASE; must return the documents list (see README).
ICEGATE_API_PATH=/documents
CACHE_SECONDS=60
PORT=3000
